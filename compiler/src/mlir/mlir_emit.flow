# @module flowc.mlir.mlir_emit
# @means  The MLIR emitter entry points for the Flow-in-Flow compiler.
#         Port of the MLIRGenerator class and the flow_to_mlir top-level in
#         src/flow/mlir_generator.py (about 7.4k lines).
#
# The Python MLIRGenerator walks the declaration list and returns MLIR text.
# Each generate_* method returns either a block of text (statements) or a
# (result_ssa, ops) pair (expressions). This port threads an MlirEmitter that
# holds the SSA counter, the indent depth, the target word size, and the type
# and op arenas. Expression emitters return an SSA number and append their ops
# to the op arena; statement emitters append to the current block. A caller
# renders the arenas to text at the end.
#
# Skeleton only. The emitter struct and the entry-point signatures mirror the
# Python public surface; bodies are stubs marked TODO(port).

import ..ast { AstArena, AST_NONE }
import .mlir_types { MlirTypeArena, flowc_mlir_types_new }
import .mlir_ops { MlirOpArena, flowc_mlir_ops_new }

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
}

# Default source-file label, matching flow_to_mlir's "unknown.flow".
export const MLIR_DEFAULT_SOURCE: i32 = 0

# function_counter = the running SSA name counter (Python function_counter).
# indent_level     = current block nesting for indent().
# size_t_bits      = 64 or 32; on 32-bit the emitter skips alloca spills and
#                    the ASYNCIFY-hostile patterns (flow#467).
# emit_gpu         = 1 to also emit the gpu module.
# emit_debug       = 1 to attach location metadata.
# types            = pointer to the shared type arena.
# ops              = pointer to the shared op arena.
export struct MlirEmitter {
    function_counter: i32,
    indent_level: i32,
    size_t_bits: i32,
    emit_gpu: i32,
    emit_debug: i32,
    types: ptr<MlirTypeArena>,
    ops: ptr<MlirOpArena>
}

# --- Emitter lifecycle ------------------------------------------

# Build an emitter over caller-owned type and op arenas. size_t_bits is 64 or
# 32. Mirrors MLIRGenerator.__init__.
export function flowc_mlir_emitter_new(
    types: ptr<MlirTypeArena>,
    ops: ptr<MlirOpArena>,
    size_t_bits: i32
) -> MlirEmitter {
    return MlirEmitter {
        function_counter: 0,
        indent_level: 0,
        size_t_bits: size_t_bits,
        emit_gpu: 0,
        emit_debug: 0,
        types: types,
        ops: ops
    }
}

# Take the next SSA number and advance the counter. This is the %N allocation
# the Python emitter does inline with self.function_counter.
export function flowc_mlir_fresh_ssa(emitter: ptr<MlirEmitter>) -> i32 {
    let n: i32 = emitter[0].function_counter
    emitter[0].function_counter = n + 1
    return n
}

