# --- Top level --------------------------------------------------

# Port of the flow_to_mlir top-level. Build an emitter, emit the module, and
# write the MLIR text to out (cap bytes). When denotational is set, the
# denotational flow.* dialect for the file's evolution blocks is prepended
# ahead of the operational lowering (see docs/design/denotational-mlir.md and
# the future compiler/src/mlir/denotational.flow). Returns bytes written, or
# negative on overflow.
export function flowc_flow_to_mlir(
    ast: AstArena,
    program_id: i32,
    source_file: i32,
    emit_gpu: i32,
    emit_debug: i32,
    size_t_bits: i32,
    denotational: i32,
    out: ptr<u8>,
    cap: i32
) -> i32 {
    # TODO(port): allocate the arenas, build the emitter, call
    # flowc_mlir_generate_module, and optionally prepend the denotational lane.
    return 0
}
