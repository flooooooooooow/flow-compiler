# @module flowc.mlir.backends.wasm
# @means  WebAssembly lowering for Flow source.
#         Port of src/flow/wasm_compiler.py (flow_to_wasm, llvm_to_wasm,
#         _validate_exports, _defined_llvm_functions).
#
# This target does not route through the C generator. Flow source is lowered by
# the MLIR/LLVM path to wasm32-compatible LLVM IR, then clang links that IR
# into a freestanding WebAssembly module (--target=wasm32-unknown-unknown,
# -nostdlib, --no-entry). Requested exports are checked against the defined
# LLVM functions before linking so a missing symbol fails early with a clear
# message.
#
# Invoking the transpiler and clang, and handling temporary files, are host
# concerns. The shapes below fix the Flow-side contract: the export check and
# the option set the host stage reads.
#
# Skeleton only. Struct and signature shapes are settled; bodies are stubs
# marked TODO(port).

import ...ast { AST_NONE }

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
    function strlen(s: string) -> i64
}

# --- Optimization level -----------------------------------------
# The -O flag passed to clang. Mirror of the choices in wasm_compiler.py
# (O0, O1, O2, O3, Os, Oz), with O2 the default.

export const WASM_OPT_O0: i32 = 0
export const WASM_OPT_O1: i32 = 1
export const WASM_OPT_O2: i32 = 2
export const WASM_OPT_O3: i32 = 3
export const WASM_OPT_OS: i32 = 4
export const WASM_OPT_OZ: i32 = 5

# --- Link options -----------------------------------------------
# allow_undefined passes -Wl,--allow-undefined; export_memory passes
# -Wl,--export-memory. With no explicit exports the linker gets --export-all.

struct WasmOptions {
    optimize: i32,
    allow_undefined: i32,
    export_memory: i32
}

# --- Export validation ------------------------------------------

# True when name appears as a defined (not declared) function in the LLVM IR.
# Mirror of the _defined_llvm_functions scan, checked one name at a time.
export function flowc_wasm_ir_defines(
    llvm_ir: ptr<u8>,
    ir_len: i32,
    name: string
) -> i32 {
    # TODO(port): scan for a `define ... @name(` line, allowing the quoted
    # "@name" form. See _defined_llvm_functions in src/flow/wasm_compiler.py.
    return 0
}

# Check that every requested export is defined in the IR.
# Returns 0 when all are present, or the count of missing exports.
# Mirror of _validate_exports.
export function flowc_wasm_validate_exports(
    llvm_ir: ptr<u8>,
    ir_len: i32,
    exports: ptr<u8>,
    export_count: i32
) -> i32 {
    # TODO(port): for each requested export, call flowc_wasm_ir_defines and
    # count the misses.
    return 0
}

# --- Lowering stages --------------------------------------------

# Link LLVM IR into a freestanding wasm32 module at output.
# Validates exports, writes the IR to a temp file, then runs clang with the
# wasm32 target and linker flags. Returns 0 on success. Host-facing stage.
# Mirror of llvm_to_wasm.
export function flowc_wasm_llvm_to_wasm(
    llvm_ir: ptr<u8>,
    ir_len: i32,
    output: string,
    opts: WasmOptions,
    exports: ptr<u8>,
    export_count: i32
) -> i32 {
    # TODO(port): flowc_wasm_validate_exports, then invoke clang
    # --target=wasm32-unknown-unknown -x ir -O<level> -nostdlib
    # -Wl,--no-entry with per-export or --export-all, --allow-undefined and
    # --export-memory as set. See llvm_to_wasm.
    return 0
}

# Compile Flow source through MLIR/LLVM IR to WebAssembly at output.
# Runs the transpiler with --wasm32 --llvm to produce IR, then links it.
# Returns 0 on success. Host-facing stage. Mirror of flow_to_wasm.
export function flowc_wasm_flow_to_wasm(
    source: string,
    output: string,
    opts: WasmOptions,
    exports: ptr<u8>,
    export_count: i32
) -> i32 {
    # TODO(port): drive the Flow -> LLVM IR transpile (native flow-driver or
    # the Python transpiler), read the emitted IR, then
    # flowc_wasm_llvm_to_wasm. See flow_to_wasm.
    return 0
}
