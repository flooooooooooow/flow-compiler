# @module flowc.mlir.mlir_ops
# @means  The MLIR operation model for the Flow-in-Flow compiler.
#         Port of the per-op emission scattered through
#         src/flow/mlir_generator.py (the arith.*, llvm.*, memref.*, cf.*,
#         func.* emitters and helpers such as _emit_alloca_store,
#         _emit_alloca_load, _llvm_zero_value).
#
# The Python emitter builds ops as formatted strings appended to a list, using
# a running SSA counter (function_counter) for result names. This port keeps
# ops as tagged records in an arena. Each op carries a result SSA number, a
# result type id (into MlirTypeArena), and up to three operand SSA numbers,
# which covers the unary, binary, load/store, and constant forms. A render step
# turns the arena into MLIR text.
#
# Skeleton only. Opcode tags and struct shapes are settled; bodies are stubs
# marked TODO(port).

import ..ast { AST_NONE }
import .mlir_types { MlirTypeArena }

extern {
    function malloc(size: i64) -> ptr<u8>
    function free(p: ptr<u8>) -> void
}

# --- Opcodes ----------------------------------------------------
# The dominant op set the emitter reaches for. Grouped by dialect. Rendering
# maps each tag back to its mnemonic via flowc_mlir_opcode_mnemonic.

export const MOP_NONE: i32 = 0

# arith dialect
export const MOP_ARITH_CONSTANT: i32 = 1
export const MOP_ARITH_ADDI: i32 = 2
export const MOP_ARITH_SUBI: i32 = 3
export const MOP_ARITH_MULI: i32 = 4
export const MOP_ARITH_ADDF: i32 = 5
export const MOP_ARITH_SUBF: i32 = 6
export const MOP_ARITH_MULF: i32 = 7
export const MOP_ARITH_DIVF: i32 = 8
export const MOP_ARITH_CMPI: i32 = 9
export const MOP_ARITH_CMPF: i32 = 10
export const MOP_ARITH_EXTUI: i32 = 11
export const MOP_ARITH_EXTSI: i32 = 12
export const MOP_ARITH_EXTF: i32 = 13
export const MOP_ARITH_INDEX_CAST: i32 = 14

# llvm dialect
export const MOP_LLVM_CONSTANT: i32 = 20
export const MOP_LLVM_UNDEF: i32 = 21
export const MOP_LLVM_ZERO: i32 = 22
export const MOP_LLVM_ALLOCA: i32 = 23
export const MOP_LLVM_LOAD: i32 = 24
export const MOP_LLVM_STORE: i32 = 25
export const MOP_LLVM_GETELEMENTPTR: i32 = 26
export const MOP_LLVM_CALL: i32 = 27

# memref dialect
export const MOP_MEMREF_ALLOC: i32 = 30
export const MOP_MEMREF_LOAD: i32 = 31
export const MOP_MEMREF_STORE: i32 = 32

# func / cf dialect
export const MOP_FUNC_CALL: i32 = 40
export const MOP_FUNC_RETURN: i32 = 41
export const MOP_CF_BR: i32 = 42
export const MOP_CF_COND_BR: i32 = 43

# No result. Store, branch, and return ops set result = MOP_NO_RESULT.
export const MOP_NO_RESULT: i32 = -1

# opcode      = one of the MOP_* tags.
# result      = SSA number this op defines, or MOP_NO_RESULT.
# ty          = result type id into the MlirTypeArena, or AST_NONE.
# a, b, c     = operand SSA numbers (unary uses a, binary a/b, store value/ptr,
#               cond_br predicate/then/else); unused slots are AST_NONE.
# ival        = immediate for constants and the predicate code for cmpi/cmpf.
# next        = sibling chain, giving a block its ordered op list.
export struct MlirOp {
    opcode: i32,
    result: i32,
    ty: i32,
    a: i32,
    b: i32,
    c: i32,
    ival: i32,
    next: i32
}

export struct MlirOpArena {
    ops: ptr<MlirOp>,
    len: i32,
    cap: i32
}

# --- Arena lifecycle --------------------------------------------

export function flowc_mlir_ops_new(cap: i32) -> MlirOpArena {
    let size: i64 = (cap as i64) * 32
    let raw: ptr<u8> = malloc(size)
    let ops: ptr<MlirOp> = raw
    # TODO(port): zero every slot the way flowc_ast_new does.
    return MlirOpArena { ops: ops, len: 0, cap: cap }
}

export function flowc_mlir_ops_free(arena: MlirOpArena) -> void {
    let raw: ptr<u8> = arena.ops
    free(raw)
}

export function flowc_mlir_op_alloc(arena: ptr<MlirOpArena>, opcode: i32) -> i32 {
    if arena[0].len >= arena[0].cap {
        return AST_NONE
    }
    let id: i32 = arena[0].len
    arena[0].len = id + 1
    arena[0].ops[id].opcode = opcode
    arena[0].ops[id].result = MOP_NO_RESULT
    arena[0].ops[id].ty = AST_NONE
    arena[0].ops[id].a = AST_NONE
    arena[0].ops[id].b = AST_NONE
    arena[0].ops[id].c = AST_NONE
    arena[0].ops[id].ival = 0
    arena[0].ops[id].next = AST_NONE
    return id
}

# --- Builders ---------------------------------------------------

# A binary arith op: result = <opcode> lhs, rhs : ty. Covers addi/subi/muli and
# the float and comparison forms.
export function flowc_mlir_op_binary(
    arena: ptr<MlirOpArena>,
    opcode: i32,
    result: i32,
    ty: i32,
    lhs: i32,
    rhs: i32
) -> i32 {
    let id: i32 = flowc_mlir_op_alloc(arena, opcode)
    if id == AST_NONE {
        return AST_NONE
    }
    arena[0].ops[id].result = result
    arena[0].ops[id].ty = ty
    arena[0].ops[id].a = lhs
    arena[0].ops[id].b = rhs
    return id
}

# An integer constant: result = arith.constant ival : ty.
export function flowc_mlir_op_constant_int(
    arena: ptr<MlirOpArena>,
    result: i32,
    ty: i32,
    value: i32
) -> i32 {
    let id: i32 = flowc_mlir_op_alloc(arena, MOP_ARITH_CONSTANT)
    if id == AST_NONE {
        return AST_NONE
    }
    arena[0].ops[id].result = result
    arena[0].ops[id].ty = ty
    arena[0].ops[id].ival = value
    return id
}

# Aggregate spill: reserve one slot and store value into it, returning the op
# that produces the !llvm.ptr result. Port of _emit_alloca_store. Aggregate
# locals live in dedicated alloca slots to dodge arm64 return-slot aliasing;
# the emitter skips this on 32-bit targets.
export function flowc_mlir_op_alloca_store(
    arena: ptr<MlirOpArena>,
    result: i32,
    value: i32,
    ty: i32
) -> i32 {
    # TODO(port): emit the constant-1, llvm.alloca, and llvm.store trio.
    return flowc_mlir_op_alloc(arena, MOP_LLVM_ALLOCA)
}

# Aggregate reload: result = llvm.load ptr : !llvm.ptr -> ty. Port of
# _emit_alloca_load.
export function flowc_mlir_op_alloca_load(
    arena: ptr<MlirOpArena>,
    result: i32,
    ptr_ssa: i32,
    ty: i32
) -> i32 {
    let id: i32 = flowc_mlir_op_alloc(arena, MOP_LLVM_LOAD)
    if id == AST_NONE {
        return AST_NONE
    }
    arena[0].ops[id].result = result
    arena[0].ops[id].ty = ty
    arena[0].ops[id].a = ptr_ssa
    return id
}

# Return the MLIR mnemonic text for an opcode ("arith.addi", "llvm.alloca", and
# so on). Used by the renderer.
export function flowc_mlir_opcode_mnemonic(opcode: i32) -> string {
    # TODO(port): a switch from tag to mnemonic literal.
    return "unknown.op"
}

# Render one op to its MLIR text line into out (cap bytes). Returns bytes
# written, or a negative value on overflow. This replaces the direct string
# appends the Python emitter does per op.
export function flowc_mlir_op_render(
    arena: MlirOpArena,
    tarena: MlirTypeArena,
    id: i32,
    out: ptr<u8>,
    cap: i32
) -> i32 {
    # TODO(port): format "%<result> = <mnemonic> <operands> : <type>".
    return 0
}
